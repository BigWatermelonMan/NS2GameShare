# Private material: never commit, including when copied beside source.
/private/
/secrets/
/captures/
*.keys
*.key
*.pem
*.p12
*.pfx
*.dmp
*.pcap
*.pcapng
*passphrase*.bin
*passphrase*.txt
*.bin
*.elf
*.ihx
*.exe
*.dll
*.zip
*.7z
.env
.env.*
settings.json
settings.input.json
*.log
*.pid
*.bak

# Generated outputs and local toolchains.
**/target/
**/build/
**/managed_components/
**/sdkconfig
**/sdkconfig.old
**/dependencies.lock
**/__pycache__/
*.pyc
/dist/

# Unfinished / research-only trees stay local; use the release allowlist.
/client-android/
/host/
/tools/*
!/tools/release/
/docs/*
!/docs/INPUT.md
!/docs/PROTOCOL.md
!/docs/DEVELOPMENT.md
